{
  "name": "cm-class",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-db.mjs",
    "build": "prisma generate && next build",
    "prestart": "node scripts/ensure-db.mjs",
    "start": "next start",
    "lint": "next lint",
    "pretest": "node scripts/ensure-db.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:ensure": "node scripts/ensure-db.mjs",
    "db:migrate": "node scripts/ensure-db.mjs && prisma migrate deploy",
    "db:push": "node scripts/ensure-db.mjs && prisma db push",
    "db:seed": "node scripts/ensure-db.mjs && tsx prisma/seed.ts",
    "db:setup": "node scripts/ensure-db.mjs && prisma migrate deploy && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "embedded-postgres": "18.6.0-beta.19",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-auth": "5.0.0-beta.25",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
